# Ambiente de execução: "development" ou "production"
# Em produção, o servidor Express serve o build estático do frontend (dist/public).
NODE_ENV=development

# Porta em que o servidor Express (backend + frontend) vai escutar localmente.
# Não é usada na Vercel (a plataforma gerencia a porta automaticamente).
PORT=5000

# Definida automaticamente pela Vercel em runtime (não precisa configurar manualmente).
# Quando presente, o app usa "/tmp/data.db" para o SQLite (armazenamento efêmero
# em ambiente serverless); caso contrário, usa "data.db" no diretório do projeto.
# VERCEL=1
